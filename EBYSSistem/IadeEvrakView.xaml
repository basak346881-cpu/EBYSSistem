<UserControl x:Class="EBYSSistem.IadeEvrakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="🔄 Yanlış Sevk Edilen / İade Edilen Evrak Listesi" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <Button x:Name="btnYenile" Content="🔄 Listeyi Yenile" Width="130" Height="36" Background="#0284C7" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Click="btnYenile_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15">
            <DataGrid x:Name="dgIadeEvraklar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Evrak Kodu" Binding="{Binding EvrakKodu}" Width="140"/>
                    <DataGridTextColumn Header="İade Eden Müdürlük" Binding="{Binding IadeEdenBirim}" Width="200"/>
                    <DataGridTextColumn Header="İade Gerekçesi" Binding="{Binding Gerekce}" Width="*"/>
                    <DataGridTextColumn Header="İade Tarihi" Binding="{Binding Tarih}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>