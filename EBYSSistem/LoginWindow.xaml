<Window x:Class="EBYSSistem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İSTANBUL SULTANGAZİ BELEDİYESİ - EBYS GİRİŞİ" 
        WindowState="Maximized"
        Background="#0F172A">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="16" Padding="40" Width="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Direction="270" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🏛️ SULTANGAZİ BELEDİYESİ" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                <TextBlock Text="Elektronik Belge Yönetim Sistemi (EBYS)" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,25"/>

                <TextBlock x:Name="lblModBaslik" Text="🔑 Personel Girişi" FontSize="15" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,15"/>

                <!-- Kullanıcı Adı / Sicil No -->
                <TextBlock Text="Kurum Sicil No veya Kullanıcı Adı" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <TextBox x:Name="txtKullaniciAdi" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" TextChanged="txtKullaniciAdi_TextChanged"/>

                <!-- Kayıt Modu TC Doğrulama -->
                <TextBlock x:Name="lblTC" Text="T.C. Kimlik No (Personel Doğrulama)" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,0,5" Visibility="Collapsed"/>
                <TextBox x:Name="txtTC" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" Visibility="Collapsed" MaxLength="11"/>

                <!-- Görevli Olduğu Birim (Girişte Kilitli/Gizli, Kayıtta Seçilebilir) -->
                <TextBlock x:Name="lblBirimEtiket" Text="Görevli Olduğu Birim" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5" Visibility="Collapsed"/>
                <ComboBox x:Name="cmbBirim" Height="40" Margin="0,0,0,15" VerticalContentAlignment="Center" FontSize="13" Visibility="Collapsed">
                    <ComboBoxItem Content="-- Çalıştığınız Müdürlüğü Seçiniz --"/>
                    <ComboBoxItem Content="Yazı İşleri Müdürlüğü (Genel Evrak Kayıt)"/>
                    <ComboBoxItem Content="Kentsel Dönüşüm Müdürlüğü"/>
                    <ComboBoxItem Content="İmar ve Şehircilik Müdürlüğü"/>
                    <ComboBoxItem Content="Yapı Kontrol Müdürlüğü"/>
                    <ComboBoxItem Content="Emlak ve İstimlak Müdürlüğü"/>
                    <ComboBoxItem Content="Fen İşleri Müdürlüğü"/>
                    <ComboBoxItem Content="Mali Hizmetler Müdürlüğü"/>
                    <ComboBoxItem Content="Hukuk İşleri Müdürlüğü"/>
                    <ComboBoxItem Content="Zabıta Müdürlüğü"/>
                    <ComboBoxItem Content="İnsan Kaynakları Müdürlüğü"/>
                    <ComboBoxItem Content="Bilgi İşlem Müdürlüğü"/>
                </ComboBox>

                <!-- Şifre -->
                <TextBlock Text="Şifre" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtSifre" Height="40" Padding="10,0" Margin="0,0,0,20" VerticalContentAlignment="Center" FontSize="14"/>

                <!-- Giriş / Kayıt Butonu -->
                <Button x:Name="btnGiris" Content="Sisteme Giriş Yap" Height="45" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="15" Cursor="Hand" IsDefault="True" Click="btnGiris_Click"/>

                <!-- Geçiş Butonu -->
                <Button x:Name="btnKayitOl" Content="👤 İlk Defa Giriş Yapıyorum (Personel Kaydı Oluştur)" Height="35" Background="Transparent" Foreground="#0284C7" BorderThickness="0" FontWeight="SemiBold" Margin="0,10,0,0" Cursor="Hand" Click="btnKayitOl_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>