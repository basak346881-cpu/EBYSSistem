<UserControl x:Class="EBYSSistem.GelenEvrakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="📥 Gelen Evrak Havalesi &amp; Onay İşlemleri" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <Button x:Name="btnYenile" Content="🔄 Listeyi Yenile" Width="130" Height="36" Background="#0284C7" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Click="btnYenile_Click"/>
            </DockPanel>
        </Border>

        <!-- Alt Bölüm: Süreç Sekmeleri (TabControl - enVision Modeli) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15">
            <TabControl x:Name="tabGelenEvrakSürecleri" SelectionChanged="tabGelenEvrakSürecleri_SelectionChanged" Background="Transparent" BorderThickness="0">
                <TabItem Header="📥 Havale Bekleyenler" FontWeight="Bold" Padding="10,6">
                    <DataGrid x:Name="dgGelenEvraklar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Evrak Kodu" Binding="{Binding EvrakKodu}" Width="140"/>
                            <DataGridTextColumn Header="Gelen Makam / Kurum" Binding="{Binding GelenMakam}" Width="200"/>
                            <DataGridTextColumn Header="Evrak Konusu" Binding="{Binding Konu}" Width="*"/>
                            <DataGridTextColumn Header="Geliş Tarihi" Binding="{Binding Tarih}" Width="130"/>
                            <DataGridTextColumn Header="Atanan Birim" Binding="{Binding HedefBirim}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="✏️ Evrak Güncelleme" FontWeight="Bold" Padding="10,6">
                    <DataGrid x:Name="dgGuncellemeBekleyenler" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Evrak Kodu" Binding="{Binding EvrakKodu}" Width="140"/>
                            <DataGridTextColumn Header="Gönderen" Binding="{Binding GelenMakam}" Width="200"/>
                            <DataGridTextColumn Header="Konu" Binding="{Binding Konu}" Width="*"/>
                            <DataGridTextColumn Header="Güncelleme Nedeni" Binding="{Binding HedefBirim}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="✍️ Evrak İmzalama" FontWeight="Bold" Padding="10,6">
                    <DataGrid x:Name="dgImzaBekleyenler" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Evrak Kodu" Binding="{Binding EvrakKodu}" Width="140"/>
                            <DataGridTextColumn Header="İmzalayacak Makam" Binding="{Binding GelenMakam}" Width="200"/>
                            <DataGridTextColumn Header="Konu" Binding="{Binding Konu}" Width="*"/>
                            <DataGridTextColumn Header="Son İmza Tarihi" Binding="{Binding Tarih}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="🔏 Evrak E-İmzalama" FontWeight="Bold" Padding="10,6">
                    <TextBlock Text="E-İmza kart okuyucu takılı ve aktif bekleniyor..." Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"/>
                </TabItem>

                <TabItem Header="📝 Evrak E-Paraflama" FontWeight="Bold" Padding="10,6">
                    <TextBlock Text="Müdürlük paraf onayında bekleyen evrak bulunmamaktadır." Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0"/>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>