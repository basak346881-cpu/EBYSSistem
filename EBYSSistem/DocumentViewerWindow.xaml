<Window x:Class="EBYSSistem.DocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sultangazi Belediyesi - EBYS Dijital Evrak Önizleme" 
        Height="780" Width="820" WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock x:Name="lblEvrakBaslik" Text="EVRAK KODU: SULTAN-2026-000001" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblEvrakTarih" Text="Tarih: 02.08.2026" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Width="700" Height="900" Background="#FFFFFF">
                    <Border BorderBrush="#CBD5E1" BorderThickness="1"/>

                    <!-- RESMİ DİJİTAL KAYIT DAMGASI -->
                    <Border Width="240" Height="75" BorderBrush="#DC2626" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="30,30,30,0" Padding="8" Background="#FEF2F2">
                        <StackPanel>
                            <TextBlock Text="T.C. SULTANGAZİ BELEDİYE BAŞKANLIĞI" Foreground="#DC2626" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Yazı İşleri Müdürlüğü Genel Evrak Kayıt" Foreground="#DC2626" FontSize="8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblDamgaEvrakNo" Text="EVRAK NO: SULTAN-2026-000001" Foreground="#DC2626" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            <TextBlock x:Name="lblDamgaTarih" Text="TARİH   : 02.08.2026 15:45" Foreground="#DC2626" FontSize="8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- A4 BELGE METNİ -->
                    <StackPanel Margin="50,120,50,50">
                        <TextBlock Text="T.C. SULTANGAZİ BELEDİYE BAŞKANLIĞINA" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E293B" Margin="0,0,0,30"/>

                        <TextBlock x:Name="lblOnizleKonu" Text="KONU: Kentsel Dönüşüm Talebi" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                        <TextBlock x:Name="lblOnizleKisi" Text="İlgili dilekçe metni buraya yüklenecektir." FontSize="13" TextWrapping="Wrap" Foreground="#334155" LineHeight="22"/>

                        <Separator Margin="0,40,0,20"/>

                        <TextBlock x:Name="lblOnizleAdres" Text="Adres: ..." FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="lblOnizleTel" Text="Telefon: ..." FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>