<Window x:Class="EBYSSistem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İSTANBUL SULTANGAZİ BELEDİYESİ - EBYS" 
        WindowState="Maximized"
        Background="#F1F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->
        <Border Grid.Column="0" Background="#0F172A">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,20,0,20">
                    <TextBlock Text="🏛️ SULTANGAZİ BLD." Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="EBYS Genel Evrak Modülü" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- EVRAK İŞLEMLERİ -->
                    <TextBlock Text="EVRAK İŞLEMLERİ" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="20,10,0,5"/>
                    <Button x:Name="btnMenuTara" Content="📄 Anlık Evrak Tara &amp; Kaydet" Height="40" Background="#1E293B" Foreground="White" FontWeight="SemiBold" Margin="12,2" Click="btnMenuTara_Click"/>
                    <Button x:Name="btnMenuGelen" Content="📥 Gelen Evrak Havalesi" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuGelen_Click"/>
                    <Button x:Name="btnMenuGiden" Content="📤 Giden Evrak / Dış Zimmet" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuGiden_Click"/>

                    <!-- SORGULAMA &amp; ARŞİV -->
                    <TextBlock Text="SORGULAMA &amp; ARŞİV" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="20,15,0,5"/>
                    <Button x:Name="btnMenuArama" Content="🔍 Detaylı Evrak Sorgulama" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuArama_Click"/>
                    <Button x:Name="btnMenuAdaParsel" Content="🗺️ Ada / Parsel / Sicil Arama" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuAdaParsel_Click"/>

                    <!-- İADE &amp; SÜREÇ TAKİBİ -->
                    <TextBlock Text="İADE &amp; SÜREÇ TAKİBİ" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="20,15,0,5"/>
                    <Button x:Name="btnMenuIade" Content="🔄 Yanlış Sevk / İade Evraklar" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuIade_Click"/>
                    <Button x:Name="btnMenuSuresiDolan" Content="⏳ Süresi Dolan Evrak Takibi" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuSuresiDolan_Click"/>

                    <!-- RAPORLAMA &amp; YÖNETİM -->
                    <TextBlock Text="RAPORLAMA &amp; YÖNETİM" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="20,15,0,5"/>
                    <Button x:Name="btnMenuRapor" Content="📊 İşlem &amp; Sevk Raporları" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuRapor_Click"/>
                    <Button x:Name="btnMenuAyarlar" Content="⚙️ Sistem &amp; Tarayıcı Ayarları" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuAyarlar_Click"/>
                    <Button x:Name="btnMenuHizTesti" Content="⚡ Sunucu Bağlantı Hızı Testi" Height="40" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="12,2" Click="btnMenuHizTesti_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- SAĞ İÇERİK BÖLGESİ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Üst Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel Margin="25,0">
                    <TextBlock x:Name="lblAktifSayfa" Text="Genel Evrak Kayıt, Otomatik Damgalama &amp; Adres Entegrasyonu" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="👤 Aktif Görevli: " FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblAktifKullanici" Text="Yükleniyor..." Foreground="#0284C7" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DİNAMİK İÇERİK ALANI -->
            <Grid Grid.Row="1">
                <!-- Modüller Buraya Yüklenir -->
                <ContentControl x:Name="MainContentArea" Visibility="Collapsed"/>

                <!-- Varsayılan Evrak Kayıt Formu -->
                <Grid x:Name="MainFormGrid" Margin="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="25" Margin="0,0,15,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- BELEDİYE SAYAÇ KARTLARI (DASHBOARD WIDGETS) -->
                                <UniformGrid Columns="2" Margin="0,0,0,20">
                                    <Border Background="#15803D" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="lblBugunGelen" Text="0" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Bugün Gelen Evrak" FontSize="12" Foreground="#DCFCE7" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#047857" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔀" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="lblBugunYapilan" Text="0" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Bugün Yapılan İşlem" FontSize="12" Foreground="#D1FAE5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- TARAYICI PARAMETRE VE TARAMA ALANI -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Button x:Name="btnAnlikTara" Content="🖨️ Tarayıcıdan Anlık Evrak Tara (Scanner)" Height="45" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Click="btnAnlikTara_Click"/>

                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox x:Name="chkCiftYuzlu" Content="Çift Yüzlü Tara" IsChecked="True" Margin="0,0,15,5" Foreground="#475569" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="chkBosAtla" Content="Boş Sayfaları Atla" IsChecked="True" Margin="0,0,15,5" Foreground="#475569" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="chkOtomatikBarkod" Content="Kayıttan Sonra Barkod Bas" IsChecked="True" Margin="0,0,15,5" Foreground="#475569" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Çözünürlük: " Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cmbTaramaDPI" Width="90" Height="24" SelectedIndex="1">
                                                    <ComboBoxItem Content="150 DPI"/>
                                                    <ComboBoxItem Content="300 DPI"/>
                                                    <ComboBoxItem Content="600 DPI"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Sistem Evrak Kodu:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBox x:Name="txtEvrakKodu" Grid.Row="0" Grid.Column="1" Margin="0,6" Height="36" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#0284C7" Padding="8,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Evrak Gönderen Türü:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="Bold" Foreground="#0284C7"/>
                                    <ComboBox x:Name="cmbGonderenTuru" Grid.Row="1" Grid.Column="1" Margin="0,6" Height="36" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="cmbGonderenTuru_SelectionChanged">
                                        <ComboBoxItem Content="-- Gönderen Türünü Seçiniz --"/>
                                        <ComboBoxItem Content="Gerçek Kişi (Vatandaş)"/>
                                        <ComboBoxItem Content="Tüzel Kişi (Firma / Şirket)"/>
                                        <ComboBoxItem Content="Yabancı Uyruklu Şahıs"/>
                                        <ComboBoxItem Content="Kamu Kurumu / Resmi Makam"/>
                                    </ComboBox>

                                    <TextBlock x:Name="lblKimlikNo" Text="Kimlik / Vergi No:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBox x:Name="txtKimlikNo" Grid.Row="2" Grid.Column="1" Margin="0,6" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>

                                    <TextBlock x:Name="lblAdUnvan" Text="Ad Soyad / Ünvan:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBox x:Name="txtAdUnvan" Grid.Row="3" Grid.Column="1" Margin="0,6" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>

                                    <TextBlock x:Name="lblTelefon" Text="Telefon No:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBox x:Name="txtTelefon" Grid.Row="4" Grid.Column="1" Margin="0,6" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Mahalle:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold" Foreground="#475569"/>
                                    <ComboBox x:Name="cmbMahalle" Grid.Row="5" Grid.Column="1" Margin="0,6" Height="36" VerticalContentAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem Content="-- Mahalle Seçiniz --"/>
                                        <ComboBoxItem Content="50. Yıl Mahallesi"/>
                                        <ComboBoxItem Content="75. Yıl Mahallesi"/>
                                        <ComboBoxItem Content="Cebeci Mahallesi"/>
                                        <ComboBoxItem Content="Esentepe Mahallesi"/>
                                        <ComboBoxItem Content="Gazi Mahallesi"/>
                                        <ComboBoxItem Content="Habibler Mahallesi"/>
                                        <ComboBoxItem Content="İsmetpaşa Mahallesi"/>
                                        <ComboBoxItem Content="Sultançiftliği Mahallesi"/>
                                    </ComboBox>

                                    <TextBlock Text="Açık Adres:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBox x:Name="txtAdres" Grid.Row="6" Grid.Column="1" Margin="0,6" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Evrak Konusu:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold" Foreground="#475569"/>
                                    <TextBox x:Name="txtKonu" Grid.Row="7" Grid.Column="1" Margin="0,6" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Sevk Yapılacak Birim:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="Bold" Foreground="#DC2626"/>
                                    <ComboBox x:Name="cmbHedefMudurler" Grid.Row="8" Grid.Column="1" Margin="0,6" Height="36" VerticalContentAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem Content="-- Otomatik Seçilecek --"/>
                                        <ComboBoxItem Content="Kentsel Dönüşüm Müdürlüğü"/>
                                        <ComboBoxItem Content="İmar ve Şehircilik Müdürlüğü"/>
                                        <ComboBoxItem Content="Yapı Kontrol Müdürlüğü"/>
                                        <ComboBoxItem Content="Emlak ve İstimlak Müdürlüğü"/>
                                        <ComboBoxItem Content="Fen İşleri Müdürlüğü"/>
                                    </ComboBox>

                                    <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                        <Button x:Name="btnGuncelle" Content="✏️ Kaydı Düzenle" Height="45" Width="180" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" Click="btnGuncelle_Click"/>
                                        <Button x:Name="btnHavaleEt" Content="🚀 Kaydet, Damgala &amp; Barkod Bas" Height="45" Width="240" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Click="btnHavaleEt_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                        <DockPanel>
                            <TextBlock Text="📋 Kayıtlı Evrak Geçmişi" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <Button x:Name="btnOnizle" Content="🔍 Seçili Evrakı Önizle (Büyüteç)" DockPanel.Dock="Bottom" Height="42" Background="#0284C7" Foreground="White" FontWeight="Bold" Margin="0,10,0,0" Click="btnOnizle_Click"/>
                            <ListBox x:Name="lstEvrakGecmisi" Background="#F8FAFC" BorderBrush="#E2E8F0" SelectionChanged="lstEvrakGecmisi_SelectionChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>