<UserControl x:Class="EBYSSistem.GidenEvrakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <TextBlock Text="📤 Giden Evrak / Dış Zimmet Kaydı" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Gideceği Kurum / Makam:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtKurum" Height="36" Margin="0,0,0,15" Padding="5,0" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Kurye / Posta Zimmet No:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtZimmetNo" Height="36" Margin="0,0,0,15" Padding="5,0" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Evrak Konusu ve Özeti:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtKonu" Height="70" Margin="0,0,0,20" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                    <Button x:Name="btnKaydetYazdir" Content="📮 Dış Zimmete Kaydet ve Yazdır" Height="42" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="btnKaydetYazdir_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                <DockPanel>
                    <TextBlock Text="📋 Zimmet Defteri Geçmişi" DockPanel.Dock="Top" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                    <ListBox x:Name="lstZimmetGecmisi" Background="#F8FAFC"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>